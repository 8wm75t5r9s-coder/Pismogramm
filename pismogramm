        .order_by(Chat.id.desc())
    ).all()

    result = []
    for chat in chats:
        if chat.kind == "group":
            title = chat.title or "Группа"
        else:
            members = db.scalars(
                select(User)
                .join(ChatMember, ChatMember.user_id == User.id)
                .where(ChatMember.chat_id == chat.id, User.id != user.id)
            ).all()
            title = members[0].username if members else user.username

        result.append({"id": chat.id, "kind": chat.kind, "title": title})
    return result


