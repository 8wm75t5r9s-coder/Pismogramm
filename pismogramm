@app.post("/api/auth/login")
def login(
    data: AuthData,
    request: Request,
    response: Response,
    db: Session = Depends(db_session),
):
    user = db.scalar(select(User).where(User.username == data.username.lower()))
    if not user or not password_hasher.verify(data.password, user.password_hash):
        raise HTTPException(status_code=401, detail="Неверное имя пользователя или пароль")

    refresh = create_session(db, user, request.headers.get("user-agent", ""))
    set_refresh_cookie(response, refresh)
    return {"access_token": make_access_token(user.id), "username": user.username}


@app.post("/api/auth/refresh")
def refresh_token(request: Request, response: Response, db: Session = Depends(db_session)):
    raw = request.cookies.get("refresh_token")
    if not raw:
        raise HTTPException(status_code=401, detail="Нет refresh-токена")

    session = db.scalar(
        select(RefreshSession).where(RefreshSession.token_hash == hash_token(raw))
    )
    if not session or session.expires_at < utcnow():
        if session:
            db.delete(session)
            db.commit()
        response.delete_cookie("refresh_token", path="/api/auth")
        raise HTTPException(status_code=401, detail="Сессия истекла")

    user = db.get(User, session.user_id)
    if not user:
        raise HTTPException(status_code=401, detail="Пользователь не найден")

    # Ротация: старый refresh-токен становится недействительным.
    db.delete(session)
    db.commit()
    new_refresh = create_session(db, user, request.headers.get("user-agent", ""))
    set_refresh_cookie(response, new_refresh)

    return {"access_token": make_access_token(user.id), "username": user.username}


