        <input id="file" type="file" accept=".png,.jpg,.jpeg,.gif,.webp,.pdf,.txt">
        <input id="text" placeholder="Сообщение…" autocomplete="off">
        <button id="send">Отправить</button>
      </form>
    </main>
  </section>

<script>
let accessToken = null;
let socket = null;
let activeChat = null;
let chats = [];

const $ = (id) => document.getElementById(id);

async function api(path, options = {}) {
  const headers = new Headers(options.headers || {});
  if (accessToken) headers.set("Authorization", `Bearer ${accessToken}`);
  if (options.body && !(options.body instanceof FormData)) {
    headers.set("Content-Type", "application/json");
  }

  let response = await fetch(path, {
    ...options, headers, credentials: "same-origin"
  });

  if (response.status === 401 && path !== "/api/auth/refresh") {
    const refreshed = await fetch("/api/auth/refresh", {
      method: "POST", credentials: "same-origin"
    });
    if (refreshed.ok) {
      const data = await refreshed.json();
      accessToken = data.access_token;
      headers.set("Authorization", `Bearer ${accessToken}`);      response = await fetch(path, {...options, headers, credentials: "same-origin"});
    }
  }
  return response;
}

function showApp() {
  $("auth").style.display = "none";
  $("app").style.display = "flex";
}

function showAuthError(message) {
  $("auth-error").textContent = message;
}

async function authenticate(path) {
  showAuthError("");
  const response = await fetch(path, {
    method: "POST",
    headers: {"Content-Type": "application/json"},
    credentials: "same-origin",
    body: JSON.stringify({
      username: $("username").value,
      password: $("password").value
    })
  });
  const data = await response.json();
  if (!response.ok) {
    showAuthError(data.detail || "Ошибка входа");
    return;
  }

  accessToken = data.access_token;
  showApp();
  connectSocket();
  await loadChats();
}

function connectSocket() {
  if (socket) socket.close();
  const protocol = location.protocol === "https:" ? "wss:" : "ws:";
  socket = new WebSocket(`${protocol}//${location.host}/ws`);

  socket.onopen = () => socket.send(JSON.stringify({token: accessToken}));
  socket.onmessage = (event) => {
    const data = JSON.parse(event.data);
    if (data.type === "message" && data.message.chat_id === activeChat) {
      addMessage(data.message);
    } else if (data.type === "error") {
      $("status").textContent = data.message;
    }
  };
  socket.onclose = () => {
    // При необходимости приложение может переподключить WebSocket.
  };
}

async function loadChats() {
  const response = await api("/api/chats");
  if (!response.ok) return;
  chats = await response.json();

  const container = $("chats");
  container.replaceChildren();
  for (const chat of chats) {
    const button = document.createElement("button");
    button.className = "chat-item" + (chat.id === activeChat ? " active" : "");
    button.textContent = `${chat.kind === "group" ? "👥 " : ""}${chat.title}`;
    button.onclick = () => openChat(chat);
    container.appendChild(button);
  }
}

async function openChat(chat) {
  activeChat = chat.id;
  $("chat-title").textContent = chat.title;
  $("messages").replaceChildren();
  $("status").textContent = "";
  await loadChats();

  const response = await api(`/api/chats/${chat.id}/messages`);
  if (!response.ok) {
    $("status").textContent = "Не удалось загрузить переписку";
    return;
  }
  for (const message of await response.json()) addMessage(message);
}

function addMessage(message) {
  const container = $("messages");
  const wrap = document.createElement("div");
  wrap.className = "message" + (message.sender === $("username").value.toLowerCase() ? " mine" : "");

  const meta = document.createElement("div");
  meta.className = "meta";
  meta.textContent = `${message.sender} · ${new Date(message.created_at).toLocaleString()}`;

  const bubble = document.createElement("div");
  bubble.className = "bubble";
  bubble.textContent = message.text;

  if (message.attachment) {
    const fileButton = document.createElement("button");
    fileButton.textContent = `📎 ${message.attachment.name}`;
    fileButton.onclick = () => downloadFile(message.attachment.id, message.attachment.name);
    bubble.append(document.createElement("br"), fileButton);
  }

  wrap.append(meta, bubble);
  container.appendChild(wrap);
  container.scrollTop = container.scrollHeight;
}

async function downloadFile(id, name) {
  const response = await api(`/api/files/${encodeURIComponent(id)}`);
  if (!response.ok) {
    $("status").textContent = "Не удалось скачать файл";
    return;
  }
  const blob = await response.blob();
  const link = document.createElement("a");
  link.href = URL.createObjectURL(blob);
  link.download = name;
  link.click();
  URL.revokeObjectURL(link.href);
}

$("login").onclick = () => authenticate("/api/auth/login");
$("register").onclick = () => authenticate("/api/auth/register-v2");

$("new-direct").onclick = async () => {
  const username = prompt("Имя пользователя:");
  if (!username) return;
    method: "POST", body: JSON.stringify({username})
  });
  const data = await response.json();
  if (!response.ok) return alert(data.detail || "Ошибка");
  await loadChats();
  const chat = chats.find(item => item.id === data.id);
  if (chat) openChat(chat);
};

$("new-group").onclick = async () => {
  const title = prompt("Название группы:");
  if (!title) return;
  const members = (prompt("Имена участников через запятую:") || "")
    .split(",").map(x => x.trim()).filter(Boolean);

  const response = await api("/api/chats/group", {
    method: "POST", body: JSON.stringify({title, members})
  });
  const data = await response.json();
  if (!response.ok) return alert(data.detail || "Ошибка");
  await loadChats();
  const chat = chats.find(item => item.id === data.id);
  if (chat) openChat(chat);
};

$("sessions").onclick = async () => {
  const response = await api("/api/sessions");
  if (!response.ok) return alert("Не удалось получить список сессий");
  const items = await response.json();
  alert(items.map(x => `${x.id}\n${x.user_agent}\nИстекает: ${x.expires_at}`).join("\n\n") || "Сессий нет");
};

$("logout").onclick = async () => {
  await api("/api/auth/logout", {method: "POST"});
  if (socket) socket.close();
  accessToken = null;
  activeChat = null;
  $("app").style.display = "none";
  $("auth").style.display = "block";
};

$("composer").onsubmit = async (event) => {
  event.preventDefault();
  if (!activeChat) {
    $("status").textContent = "Сначала выберите чат";
    return;
  }

  const text = $("text").value.trim();
  const file = $("file").files[0];
  if (!text && !file) return;

  let attachment_id = null;
  if (file) {
    const form = new FormData();
    form.append("file", file);
    const response = await api(`/api/chats/${activeChat}/upload`, {
      method: "POST", body: form
    });
    const data = await response.json();
    if (!response.ok) {
      $("status").textContent = data.detail || "Ошибка загрузки";
      return;
    }
    attachment_id = data.id;
  }

  if (!socket || socket.readyState !== WebSocket.OPEN) {
    $("status").textContent = "Нет соединения с сервером";
    return;
  }

  socket.send(JSON.stringify({chat_id: activeChat, text, attachment_id}));
  $("text").value = "";
  $("file").value = "";
};

(async function restoreSession() {
  const response = await fetch("/api/auth/refresh", {
    method: "POST", credentials: "same-origin"
  });
  if (!response.ok) return;

  const data = await response.json();
  accessToken = data.access_token;
  $("username").value = data.username;
  showApp();
  connectSocket();
  await loadChats();
})();
</script>
</body>
</html>
